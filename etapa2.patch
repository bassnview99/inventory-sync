+    headers: { "X-Admin-Key": adminKey, "Content-Type": "application/json", ...(options.headers || {}) },
+  });
+  if (!response.ok) {
+    let detail = `Error ${response.status}`;
+    try { detail = (await response.json()).detail || detail; } catch { /* sin cuerpo */ }
